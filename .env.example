# ============================================================================
# Social Monitor — Client Configuration
# Copy this file to `.env` and fill in your client-specific values.
# Never commit `.env` to git.
# ============================================================================

# === Client identity (shows in dashboard) ===
CLIENT_NAME=Acme Corp
CLIENT_SLUG=acme
CLIENT_TAGLINE=Social Media & Ads Monitor
CLIENT_LOCATION=Panama
CLIENT_DESCRIPTION=una empresa de servicios automotrices

# === Brand colors (hex) — used in dashboard accents ===
# Primary accent (sparklines, signature cards bg)
BRAND_COLOR=#00d750
# Deep variant (signature card backgrounds)
BRAND_COLOR_DEEP=#0a3d18

# === Meta API credentials ===
# Generate a System User token from Meta Business Manager
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_APP_ID=
META_APP_SECRET=

# === Client's Meta accounts ===
# Find IG Business Account ID in Meta Business Suite → Settings → Accounts
INSTAGRAM_ACCOUNT_ID=
# Facebook Page ID
FACEBOOK_PAGE_ID=
# Ad Account ID (without "act_" prefix)
AD_ACCOUNT_ID=

# === Campaign filter ===
# Word that appears in this client's campaign names. Empty = sync ALL campaigns.
# Example: if their campaigns are named "Acme - Spring 2026", set CAMPAIGN_FILTER=acme
CAMPAIGN_FILTER=

# === AI Insights (Anthropic) ===
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSIGHTS_WINDOW_DAYS=30
# Cron expression for daily insights generation. Default: 11 UTC = 6 AM Panama
INSIGHTS_CRON=0 11 * * *

# === Server ===
# Each client must use a unique port if running multiple on same VPS
PORT=3002
# DB filename (defaults to <CLIENT_SLUG>.db if unset)
# DB_NAME=acme.db

# === Cloudflare (optional — used by provision-client.sh) ===
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
TUNNEL_ID=
