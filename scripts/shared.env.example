# ============================================================================
# VPS-level shared secrets used by provision-client.sh
#
# Place this at /opt/clients/.shared/shared.env on your VPS.
# These are credentials that are SHARED across all clients (e.g. your single
# Meta System User token, your Anthropic key, your Cloudflare token).
#
# Per-client secrets (IG ID, Page ID, Ad Account) are NOT here — they go in
# each client's own .env, generated by the script.
#
# chmod 600 this file. Never commit to git.
# ============================================================================

# Meta System User Token (no expiration, accesses partner-shared assets)
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx

# Anthropic API key (one bill, all clients)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx

# Cloudflare DNS automation
CLOUDFLARE_API_TOKEN=cfut_xxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ZONE_ID=8470b62f2f2ecb023680f259972e5d22

# Cloudflare Tunnel — same tunnel used by all clients
TUNNEL_ID=d569f2be-b952-4f62-b73f-36dbd85d440b

# Optional overrides
# REPO_URL=https://github.com/hrikrdo/social-monitor-boilerplate.git
# CLIENTS_DIR=/opt/clients
# CLOUDFLARED_CONFIG=/etc/cloudflared/config.yml
